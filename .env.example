# Optional OpenAI-compatible provider settings. Keep real keys in .env only.
# For Ollama, use http://localhost:11434/v1 and set the model to a name shown by `ollama list`.
# Ollama accepts a placeholder key such as `ollama`; hosted providers require their real key.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

